# Practice ontology - CREATE YOUR OWN ONTOLOGY
# Scratch file for learning OWL/RDF, built by hand step by step.

@prefix :     <https://example.org/yourownontology/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/yourownontology/>
    a owl:Ontology ;
    rdfs:label "ontology"@en ; 
    rdfs:comment "Learning file."@en ;
    owl:versionInfo "0.1.0" .

